prefix=riscv_install
exec_prefix=${prefix}
libdir=riscv_install/lib
includedir=riscv_install/include

Name: libavcodec
Description: FFmpeg codec library
Version: 58.134.100
Requires: 
Requires.private: libswresample >= 3.9.100, libavutil >= 56.70.100
Conflicts:
Libs: -L${libdir}  -lavcodec 
Libs.private: -pthread -lm -latomic
Cflags: -I${includedir}
